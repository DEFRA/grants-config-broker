{
  "name": "grants-config-broker",
  "version": "0.0.0",
  "description": "grants-config-broker",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev": "AWS_EMF_ENVIRONMENT=Local NODE_ENV=development npm run server:watch",
    "dev:debug": "AWS_EMF_ENVIRONMENT=Local NODE_ENV=development npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "generate:asyncapi": "npx @asyncapi/cli@6.0.2 generate fromTemplate src/docs/asyncapi.yaml @asyncapi/html-template@3.5.4 -o src/routes/asyncapidocs --force-write --param baseHref=/async-documentation/",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "postinstall": "npm run setup:husky",
    "security-audit": "npm audit --audit-level=high",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch ./src",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json,yml --legacy-watch ./src ./compose",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node --use-strict .",
    "test": "TZ=UTC vitest run --coverage",
    "test:no-coverage": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@aws-sdk/client-sns": "3.1112.0",
    "@aws-sdk/client-sqs": "3.1112.0",
    "@aws-sdk/credential-providers": "3.1112.0",
    "@defra/cdp-auditing": "0.6.1",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/fcp-audit-publisher": "1.0.7",
    "@defra/grants-config-utils": "1.2.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "7.1.2",
    "@hapi/jwt": "3.2.4",
    "aws-embedded-metrics": "4.2.1",
    "aws4": "1.13.2",
    "brace-expansion": "5.0.9",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "hapi-scalar": "1.1.0",
    "http-status-codes": "2.3.0",
    "joi": "18.2.3",
    "js-yaml": "5.3.0",
    "mongo-locks": "3.2.0",
    "mongodb": "7.5.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "semver": "7.8.5"
  },
  "overrides": {
    "minimatch": "10.2.3",
    "fast-xml-parser": "5.7.0",
    "joi": "18.2.3",
    "eslint": "10.7.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.5.4",
    "eslint": "10.7.0",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "vitest": "4.1.10",
    "vitest-fetch-mock": "0.4.5",
    "vitest-mongodb": "1.0.3"
  }
}
